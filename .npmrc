# Save exact versions (no ~ or ^) for consistent installs
save-exact=true

# Package-lock settings
package-lock=true
lockfile-version=3

# Default settings for your CLI package
init-version=1.3.4
init-author-name=div0ky
init-license=MIT

# Disable funding/update messages since it's a CLI tool
fund=false
update-notifier=false

# Set registry
registry=https://registry.npmjs.org/